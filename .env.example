# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://jee:jeepass@localhost:5432/jeedb

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars

# ── App behaviour ─────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database pool (optional tuning) ──────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Override only if API is on a different host/port in dev
# VITE_API_URL=http://localhost:8000
